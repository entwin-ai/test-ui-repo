# Google OAuth — create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials
# Add BOTH authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google      (base sign-in)
#   http://localhost:3000/api/gmail/callback             (Gmail read scope)
# Also enable the Gmail API for the project and add the
# .../auth/gmail.readonly scope on the OAuth consent screen.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Durable token store (required on Vercel / any multi-instance deploy).
# Vercel → Storage → Create → Upstash Redis gives you both values.
# Without these, Gmail tokens are held in-memory only and are lost when the
# callback and scan run on different serverless instances — the scan then
# fails with "Gmail is not connected for this card". Local `next dev` works
# without them (single process), so they're optional for local-only use.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── RAG additions (Supabase + LLMs + GitHub dispatch) ───────────────────────
# Supabase project — Settings → API. The SERVICE ROLE key is server-only; it
# bypasses RLS and must never reach the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM keys are now PER-USER (set in the app's Settings page) and stored
# encrypted in Redis. The app and the worker no longer hold a shared provider
# key. They DO share this secret, used to encrypt/decrypt the per-user keys.
# Generate with: openssl rand -base64 32
ENTWIN_KEY_SECRET=replace-with-a-long-random-string

# Embedding model per provider (Option A — config-driven, no hardcoding).
# These are OPTIONAL; if unset, the app uses the sensible defaults shown.
# Override when a provider renames/retires a model so it's a config change,
# not a code deploy. Set the SAME values in the GitHub Actions `ingestion`
# environment so the worker and the app agree.
# CLAUDE_EMBED_MODEL=voyage-3
# OPENAI_EMBED_MODEL=text-embedding-3-small
# GEMINI_EMBED_MODEL=gemini-embedding-001

# GitHub dispatch — lets /api/gmail/ingest trigger the backfill workflow, and
# lets "Kill My Twin" cancel a user's in-flight Actions runs during teardown.
# GH_DISPATCH_TOKEN = a fine-grained PAT with Actions: read/write on the repo
# (read to list in-progress runs, write to cancel them + dispatch workflows).
GH_REPO=your-github-owner/your-repo
GH_DISPATCH_TOKEN=your-fine-grained-pat

# ─── WhatsApp connector (BATCH / hourly — no always-on host) ─────────────────
# WhatsApp is ingested by a BOUNDED hourly GitHub Actions job
# (.github/workflows/whatsapp-sync.yml). Each run loads the device credentials
# from Redis, opens a short-lived Baileys socket, drains WhatsApp's offline
# backlog, vectorizes it, and exits. NO socket is held between runs, so the app
# runs fine on serverless (Vercel included) — there is NO persistent-host
# requirement and ENTWIN_DATA_DIR is NOT used for WhatsApp anymore.
#
# Credentials live in the SAME Upstash Redis as Gmail tokens / LLM keys, under
# entwin:wa:creds:* and entwin:wa:keys:*. No new store is needed.
#
# One-time pairing (per user): dispatch the `whatsapp-pair` workflow (or run
# `cd worker && USER_EMAIL=you@x.com WA_PHONE=13125551234 npm run pair`), read
# the printed code, and enter it on the phone. After that the hourly job runs
# unattended.
#
# The hourly job reuses the existing `ingestion` Actions environment secrets
# (SUPABASE_*, UPSTASH_*, ENTWIN_KEY_SECRET, *_EMBED_MODEL). Add VOYAGE_API_KEY
# only if a user picks the Claude provider (Claude embeds via Voyage).
# VOYAGE_API_KEY=pa-your-voyage-key
#
# Optional per-run drain tuning (repo Variables, not secrets):
#   WA_DRAIN_MS  hard ceiling for the drain window per account (default 90000)
#   WA_QUIET_MS  idle gap that signals the backlog is drained (default 8000)

# Self-hosted providers (neocloud / onprem) are OpenAI-compatible. The chat
# model is whatever the endpoint serves; the embedding model defaults to
# text-embedding-3-small and can be overridden:
# SELF_HOSTED_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Google Drive ingestion (Google Drive Ingestion Read Me)
# ---------------------------------------------------------------------------
# Connecting "Google Drive — Personal" runs a read-only OAuth flow (reuses the
# existing GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET), lets the user pick folders,
# and turns files into Memory Notes. First connect + "Read Now" run in the app.
#
# The recurring once-per-day scan (Read Me §1) is driven by the drive-scan.yml
# cron, which POSTs the app's /api/drive/scan-all endpoint on a heartbeat. That
# endpoint has no user session, so it is gated by a shared secret. Set the SAME
# value here (server env) and as the CRON_SECRET repo secret used by the
# workflow, plus APP_BASE_URL so the workflow knows where to call.
# CRON_SECRET=generate-a-long-random-string
#
# Repo secrets the drive-scan workflow needs (Settings -> Secrets -> Actions):
#   APP_BASE_URL   e.g. https://your-app.vercel.app   (no trailing slash)
#   CRON_SECRET    must match the server-side CRON_SECRET above
#
# Optional Drive tuning (server env or repo Variables):
#   DRIVE_LARGE_FILE_PAGE_THRESHOLD  pages/slides before per-page split (default 40)
#   DRIVE_EXCEL_ENTITY_CAP           distinct entities before the no-extraction
#                                    treatment on a data-heavy sheet (default 25)
